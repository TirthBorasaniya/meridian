# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/
env/

# Environment variables and secrets.
# .env.* covers .env.local, .env.production and similar; .env.example is the
# committed template and is explicitly re-included.
.env
.env.*
!.env.example
*.pem
*.key

# Local Claude Code settings (machine-specific, not for the repo)
.claude/

# Claude Code project spec / instructions (kept local, not published)
CLAUDE.md
CLAUDE_p2.md

# Data artifacts (regenerated by the ingestion pipeline).
# Directories are retained via .gitkeep; their contents are ignored.
data/corpus/raw/*
!data/corpus/raw/.gitkeep
# Docling output. Regenerated by parse_pdf from the raw PDFs; full paper text
# is not redistributed here because per-paper arXiv licences vary.
data/corpus/parsed/*
!data/corpus/parsed/.gitkeep
data/qdrant_db/*
!data/qdrant_db/.gitkeep
# The SqliteSaver sidecars carry the same conversation state as the .db file
# itself, so they are ignored by suffix as well as by path.
data/checkpoints/*.db
data/checkpoints/*.db-wal
data/checkpoints/*.db-shm
data/eval_results/*
!data/eval_results/.gitkeep

# Databases and their SQLite sidecars, wherever they land.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Model weights and checkpoints. Never committed; fetched from the hub or
# produced by the pipeline.
*.pt
*.bin
*.safetensors
*.gguf

# Hugging Face / sentence-transformers model cache
.cache/

# Node (no JS in the project today; defensive)
node_modules/

# Prefect local state
.prefect/

# OS and editor
.DS_Store
.idea/
.vscode/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
