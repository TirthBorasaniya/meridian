# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/
env/

# Environment variables and secrets
.env

# Local Claude Code settings (machine-specific, not for the repo)
.claude/

# Claude Code project spec / instructions (kept local, not published)
CLAUDE.md
CLAUDE_p2.md

# Data artifacts (regenerated by the ingestion pipeline).
# Directories are retained via .gitkeep; their contents are ignored.
data/corpus/raw/*
!data/corpus/raw/.gitkeep
data/qdrant_db/*
!data/qdrant_db/.gitkeep
data/checkpoints/*.db
data/eval_results/*
!data/eval_results/.gitkeep

# Hugging Face / sentence-transformers model cache
.cache/

# Prefect local state
.prefect/

# OS and editor
.DS_Store
.idea/
.vscode/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
