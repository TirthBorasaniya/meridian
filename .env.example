# Meridian environment configuration.
# Copy to .env and fill in values. Never commit .env.
#   cp .env.example .env

# --- Groq API (LLM inference) ---
GROQ_API_KEY=

# --- Tavily API (CRAG web search fallback) ---
TAVILY_API_KEY=

# --- Langfuse (per-node observability) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- PostgreSQL (paper metadata, ingestion state) ---
DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5432/meridian

# --- Qdrant vector store ---
# Leave QDRANT_URL empty to use local disk persistence at QDRANT_PATH.
# Set QDRANT_URL (e.g. http://localhost:6333) to target a Qdrant server.
# QDRANT_API_KEY applies to server mode only. Leave it empty for a local
# Docker Compose Qdrant (no auth); set it for a managed deployment such as
# Qdrant Cloud, which rejects unauthenticated requests.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant_db
QDRANT_COLLECTION=meridian_papers

# --- Models ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
GRADING_MODEL=llama-3.1-8b-instant
GENERATION_MODEL=llama-3.3-70b-versatile

# --- Checkpointing ---
CHECKPOINT_DB_PATH=data/checkpoints/graph.db

# --- Cross-session memory (distinct from the SqliteSaver checkpointer above) ---
SESSION_DB_PATH=data/checkpoints/sessions.db
SESSION_CONTEXT_TURNS=6
