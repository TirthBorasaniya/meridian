# Meridian environment variables. Copy to .env and fill in values; .env is never committed.
#   cp .env.example .env

# ============= LLM and web search =============
GROQ_API_KEY=your-groq-api-key
TAVILY_API_KEY=your-tavily-api-key

# ============= Hugging Face =============
# write access to the private index dataset repo (CI) or read-only (demo Space)
HF_TOKEN=your-hugging-face-token
HF_INDEX_REPO=your-hf-user/meridian-index
HF_MODEL_REPO=your-hf-user/meridian-bge-small-arxiv
HF_SPACE_REPO=your-hf-user/meridian

# ============= Observability =============
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ============= Services =============
# empty QDRANT_URL selects embedded local mode at QDRANT_PATH
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant_local
# empty REDIS_URL selects in-process caches
REDIS_URL=redis://127.0.0.1:6379/0

# ============= Runtime =============
# serving profile: serving (local) or demo (public Space)
MERIDIAN_SERVING_PROFILE=serving
LLM_CACHE_PATH=.cache/llm_cache.sqlite
MERIDIAN_SERVICE=meridian
LOG_LEVEL=INFO
MERIDIAN_DEMO_URL=
